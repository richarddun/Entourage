#:kivy 2.2.0
#:import Factory kivy.factory.Factory

<ConfigurationPopup@Popup>:
    id: configuration_popup
    title: "Configuration"
    size_hint: 0.9, 0.9
    background: 'atlas://data/images/defaulttheme/button'
    separator_color: 0.2, 0.6, 0.8, 1
    title_color: 1, 1, 1, 1

    BoxLayout:
        orientation: "horizontal"
        padding: 10
        spacing: 10

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            size_hint_x: 0.7
            bar_width: 8
            bar_color: [0.2, 0.5, 0.8, 0.8]
            bar_inactive_color: [0.5, 0.5, 0.5, 0.3]
            scroll_type: ['bars']
            scroll_wheel_distance: 20

            GridLayout:
                id: button_layout
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: 5
                padding: 5

        ScrollView:
            size_hint_x: 0.3
            do_scroll_x: False
            do_scroll_y: True
            bar_width: 6
            bar_color: [0.2, 0.5, 0.8, 0.8]

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: 10
                padding: 5

                Button:
                    size_hint_y: None
                    height: 50
                    text: "New Session"
                    background_color: 0.2, 0.7, 0.3, 1
                    on_release: root.add_new_session()

                Button:
                    size_hint_y: None
                    height: 50
                    text: "Remove Session"
                    background_color: 0.8, 0.2, 0.2, 1
                    on_release: root.delete_session()

                Button:
                    size_hint_y: None
                    height: 50
                    text: "Save and Return"
                    background_color: 0.2, 0.5, 0.8, 1
                    on_release: root.save_sessions()

                Widget:
                    size_hint_y: None
                    height: 20

                Label:
                    size_hint_y: None
                    height: 30
                    text: "Voice Persona"
                    color: 0.2, 0.2, 0.2, 1
                    bold: True

                Button:
                    id: voicebutton
                    text: 'Rachel (Default)'
                    size_hint_y: None
                    height: 50
                    background_color: 0.3, 0.3, 0.3, 1
                    color: 1, 1, 1, 1

                    Widget:
                        size_hint_y: None
                        height: 15

                    Label:
                        size_hint_y: None
                        height: 30
                        text: "Voice Effects"
                        color: 0.2, 0.2, 0.2, 1
                        bold: True

                    BoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: 40
                        spacing: 10

                        Label:
                            text: "Emotion"
                            size_hint_x: 0.3
                            color: 0.2, 0.2, 0.2, 1

                        Slider:
                            id: stability_slider
                            min: 0
                            max: 1
                            value: 0.5
                            size_hint_x: 0.7

                    BoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: 40
                        spacing: 10

                        Label:
                            text: "Speed"
                            size_hint_x: 0.3
                            color: 0.2, 0.2, 0.2, 1

                        Slider:
                            id: speed_slider
                            min: 0.7
                            max: 1.2
                            value: 1.0
                            size_hint_x: 0.7

                    BoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: 40
                        spacing: 10

                        Label:
                            text: "Style"
                            size_hint_x: 0.3
                            color: 0.2, 0.2, 0.2, 1

                        Slider:
                            id: style_slider
                            min: 0
                            max: 1
                            value: 0.0
                            size_hint_x: 0.7

                Widget:
                    size_hint_y: None
                    height: 20

                Label:
                    size_hint_y: None
                    height: 30
                    text: "Persona Instructions"
                    color: 0.2, 0.2, 0.2, 1
                    bold: True

                TextInput:
                    id: system_prompt_input
                    size_hint_y: None
                    height: 150
                    multiline: True
                    background_color: .08, .28, .35, .8
                    foreground_color: 0, 0, 0, 1
                    font_size: 14
                    padding: 10
                    text: "You are a witty and keen conversationalist. You try to keep your responses as short as possible but always try to be friendly and humorous."
                    canvas.before:
                        Color:
                            rgba: 0.8, 0.8, 0.8, 1
                        Line:
                            width: 1
                            rectangle: self.x, self.y, self.width, self.height

                Button:
                    size_hint_y: None
                    height: 40
                    text: "Reset to Default"
                    background_color: 0.6, 0.6, 0.6, 1
                    color: 1, 1, 1, 1
                    on_release: root.reset_system_prompt()

                Widget:
                    size_hint_y: None
                    height: 10

<VoiceConfigButton@Button>:
    size_hint_y: None
    height: 50
    background_color: 0.25, 0.25, 0.25, 1
    color: 1, 1, 1, 1

<CustomDropDown>:
    auto_width: False
    width: 250

    VoiceConfigButton:
        text: '👤 Regular Voices'
        disabled: True
        background_color: 0.4, 0.4, 0.4, 1

    VoiceConfigButton:
        text: 'Rachel (Default)'
        on_release: root.select(self.text)

    VoiceConfigButton:
        text: 'Adam'
        on_release: root.select(self.text)

    VoiceConfigButton:
        text: 'Matilda'
        on_release: root.select(self.text)

    VoiceConfigButton:
        text: 'Ana'
        on_release: root.select(self.text)

    VoiceConfigButton:
        text: '🎭 Character Voices'
        disabled: True
        background_color: 0.4, 0.4, 0.4, 1

    VoiceConfigButton:
        text: '🧙‍♂️ Old Wizard'
        on_release: root.select(self.text)

    VoiceConfigButton:
        text: '🤖 Android X.Y.Z.'
        on_release: root.select(self.text)

    VoiceConfigButton:
        text: '🧚‍♀️ Seer Morganna'
        on_release: root.select(self.text)

    VoiceConfigButton:
        text: '🎪 Timmy Medieval'
        on_release: root.select(self.text)

    VoiceConfigButton:
        text: '🐭 Michael Mouse'
        on_release: root.select(self.text)

    VoiceConfigButton:
        text: '👹 Evil Witch'
        on_release: root.select(self.text)

    VoiceConfigButton:
        text: '🌟 Kawaii Aerisita'
        on_release: root.select(self.text)

    VoiceConfigButton:
        text: '😂 Lutz Laugh'
        on_release: root.select(self.text)

<ChattorFlow>:
    canvas.before:
        Color:
            rgba: 0.61, 0.88, 0.62, 0.8  # Light gray background
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: 10
        spacing: 10

        # Chat display area with scrollable view
        ScrollView:
            id: scroll_view
            size_hint_y: 0.7
            do_scroll_x: False
            do_scroll_y: True
            bar_width: 10
            bar_color: [0.2, 0.5, 0.8, 0.8]
            bar_inactive_color: [0.5, 0.5, 0.5, 0.3]
            scroll_type: ['bars']

            TextInput:
                id: outputwidget
                size_hint_y:None
                height: max(self.minimum_height, scroll_view.height)
                text: ''
                readonly: True
                background_color: .08, .28, .35, .8
                foreground_color: 0, 0, 0, 1
                font_size: 16
                padding: 15
                multiline: True
                text_size: self.width - 30, None
                selection_color: [0, 0, 0, 0]
                cursor_color: [0, 0, 0, 0]
                # Add a subtle border
                canvas.before:
                    Color:
                        rgba: 0.8, 0.8, 0.8, 1
                    Line:
                        width: 1
                        rectangle: self.x, self.y, self.width, self.height

        # Input area
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: 0.3
            spacing: 10

            SmartTextInput:
                id: inputwidget
                size_hint_y: 0.7
                text: 'Type your message here...'
                background_color: .08, .28, .35, .8
                foreground_color: 0, 0, 0, 1
                font_size: 15
                padding: 15
                on_touch_down: app.first_clear()
                multiline: True
                # Add a subtle border
                canvas.before:
                    Color:
                        rgba: 0.8, 0.8, 0.8, 1
                    Line:
                        width: 1
                        rectangle: self.x, self.y, self.width, self.height

            # Button row
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: 0.3
                spacing: 10

                Button:
                    id: submitter
                    text: 'Submit'
                    size_hint_x: 0.3
                    background_color: 0.2, 0.6, 0.8, 1
                    color: 1, 1, 1, 1
                    bold: True
                    on_press: app.submit()
                    canvas.before:
                        PushMatrix
                        Rotate:
                            angle: self.angle if hasattr(self, 'angle') else 0
                            origin: self.center
                    canvas.after:
                        PopMatrix

                Button:
                    id: vsession
                    text: 'Push to Talk'
                    size_hint_x: 0.5
                    background_color: 0.5, 0.5, 0.7, 1
                    color: 1, 1, 1, 1
                    bold: True
                    on_press: app.voicemode_toggle()

                Button:
                    id: switcher
                    text: 'Settings'
                    size_hint_x: 0.2
                    background_color: 0.4, 0.4, 0.4, 1
                    color: 1, 1, 1, 1
                    bold: True
                    on_release: Factory.ConfigurationPopup().open()
